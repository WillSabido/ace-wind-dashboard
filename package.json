{
	"name": "ace-wind-dashboard",
	"version": "1.1.1",
	"private": true,
	"description": "Front-end tests for the ACE Wind Turbine Dashboard WordPress plugin",
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"check": "npm run typecheck && npm test && node scripts/build.mjs --verify"
	},
	"jest": {
		"testEnvironment": "jsdom",
		"testMatch": [
			"<rootDir>/tests/js/**/*.test.js"
		],
		"collectCoverageFrom": [
			"src/**/*.ts"
		],
		"restoreMocks": true,
		"setupFilesAfterEnv": [
			"<rootDir>/tests/js/setup.js"
		],
		"transform": {
			"^.+\\.ts$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.test.json"
				}
			]
		},
		"moduleFileExtensions": [
			"ts",
			"js",
			"json"
		],
		"coverageThreshold": {
			"global": {
				"statements": 97,
				"branches": 88,
				"functions": 98,
				"lines": 98
			}
		}
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"esbuild": "^0.28.2",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"ts-jest": "^29.4.15",
		"typescript": "^5.9.3",
		"uplot": "^1.6.31"
	}
}
