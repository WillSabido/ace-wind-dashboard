{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ace-wind/live-reading",
	"title": "ACE Live Reading",
	"category": "widgets",
	"icon": "performance",
	"description": "A live readout from the Ambition Community Energy wind turbine (power, wind speed, direction, rotor speed or any other measurement) with an animated icon.",
	"keywords": ["wind", "turbine", "energy", "live", "power", "ace"],
	"textdomain": "ace-wind-dashboard",
	"attributes": {
		"metric": { "type": "string", "default": "power" },
		"family": { "type": "string", "default": "" },
		"field": { "type": "string", "default": "" },
		"unit": { "type": "string", "default": "" },
		"decimals": { "type": "number", "default": -1 },
		"showLabel": { "type": "boolean", "default": true },
		"label": { "type": "string", "default": "" },
		"showDetail": { "type": "boolean", "default": true },
		"showUpdated": { "type": "boolean", "default": false },
		"directionFormat": { "type": "string", "default": "both" },
		"icon": { "type": "string", "default": "auto" },
		"iconUrl": { "type": "string", "default": "" },
		"iconColor": { "type": "string", "default": "" },
		"layout": { "type": "string", "default": "left" },
		"iconSize": { "type": "number", "default": 56 },
		"animate": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["left", "center", "right", "wide"],
		"color": { "background": true, "text": true, "gradients": true },
		"spacing": { "padding": true, "margin": true },
		"typography": { "fontSize": true },
		"__experimentalBorder": { "color": true, "radius": true, "style": true, "width": true }
	},
	"editorScript": "file:./editor.js",
	"viewScript": "file:./view.js",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css"
}
